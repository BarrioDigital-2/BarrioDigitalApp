# Azure AD (mismo Application ID para SPA y API expuesta)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Microservicio requests (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=barriodigital
DB_USERNAME=root
DB_PASSWORD=root

# BFF → requests (en EC2 suele ser http://127.0.0.1:8081)
REQUESTS_SERVICE_URL=http://127.0.0.1:8081

# Orígenes del frontend separados por coma (local + URL pública en AWS)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Escuchar en todas las interfaces (necesario en EC2)
SERVER_ADDRESS=0.0.0.0
